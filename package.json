{
  "name": "paipan-app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "prestart": "node tools/run.js tools/check-node.js",
    "start": "node tools/run.js node_modules/expo/bin/cli start",
    "build:web": "node tools/run.js node_modules/expo/bin/cli export -p web --output-dir dist",
    "android": "node tools/run.js node_modules/expo/bin/cli start --android",
    "ios": "node tools/run.js node_modules/expo/bin/cli start --ios",
    "check:node": "node tools/run.js tools/check-node.js",
    "setup:node": "node tools/run.js tools/setup-node.js --write",
    "login": "node tools/run.js node_modules/expo/bin/cli login",
    "login:browser": "node tools/run.js node_modules/expo/bin/cli login --browser",
    "logout": "node tools/run.js node_modules/expo/bin/cli logout",
    "whoami": "node tools/run.js node_modules/expo/bin/cli whoami",
    "fix:metro": "node tools/run.js tools/fix-metro.js",
    "fix:modules": "node tools/run.js tools/repair-modules.js",
    "check:modules": "node tools/run.js tools/repair-modules.js --check",
    "test": "node tools/run.js tests/test.js && node tools/run.js tests/logic-check.js && node tools/run.js tests/chart-view-check.js && node tools/run.js tests/pingqi-check.js && node tools/run.js tests/wiring-check.js && node tools/run.js tests/gitee-check.js && node tools/run.js tests/session-check.js && node tools/run.js tests/screens-check.js && node tools/run.js tests/cloudbase-check.js && node tools/run.js tests/local-check.js && node tools/run.js tests/node-resolution-check.js",
    "test:core": "node tools/run.js tests/test.js",
    "test:logic": "node tools/run.js tests/logic-check.js",
    "test:chart": "node tools/run.js tests/chart-view-check.js",
    "test:wiring": "node tools/run.js tests/wiring-check.js",
    "test:gitee": "node tools/run.js tests/gitee-check.js",
    "test:session": "node tools/run.js tests/session-check.js",
    "test:screens": "node tools/run.js tests/screens-check.js",
    "test:cloudbase": "node tools/run.js tests/cloudbase-check.js",
    "test:local": "node tools/run.js tests/local-check.js",
    "probe:cloudbase": "node tools/run.js tools/probe-cloudbase.js",
    "test:node": "node tools/run.js tests/node-resolution-check.js",
    "check:tsc": "node tools/run.js node_modules/typescript/lib/tsc.js --noEmit",
    "qr": "node tools/run.js tools/qr.js",
    "qr:verify": "node tools/run.js tools/verify-qr.js",
    "diagnose": "node tools/run.js tools/diagnose.js",
    "tunnel": "node tools/run.js tools/tunnel-qr.js",
    "test:pingqi": "node tools/run.js tests/pingqi-check.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.13",
    "typescript": "~5.9.2"
  }
}
